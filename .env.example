# Copy to .env and adjust. Never commit .env.
# Values here are local test defaults only; production values live on the server.

# --- Postgres (docker compose) ---
POSTGRES_USER=appleway
POSTGRES_PASSWORD=appleway
POSTGRES_DB=appleway
POSTGRES_PORT=5432

# --- api ---
NODE_ENV=development
API_PORT=3000
CORS_ORIGINS=*
DEFAULT_TIMEZONE=Asia/Tashkent

# Used when running the api on the host (pnpm --filter api dev) against the
# dockerised Postgres. Inside docker compose the host is "postgres" instead.
DATABASE_URL=postgresql://appleway:appleway@localhost:5432/appleway?schema=public

# --- mobile ---
# Your computer's LAN IP so a phone on the same Wi-Fi can reach the api.
# Find it with: ipconfig getifaddr en0
# This value is compiled into the app: never put a secret in an EXPO_PUBLIC_* var.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
