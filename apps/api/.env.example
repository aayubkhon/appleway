# Copy to apps/api/.env when running the api on the host (pnpm --filter api dev)
# or for the end-to-end test. Inside docker compose these come from the compose
# file instead. Never commit a real .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://appleway:appleway@localhost:5432/appleway?schema=public
CORS_ORIGINS=*
DEFAULT_TIMEZONE=Asia/Tashkent
# At least 32 random characters, e.g. from: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
